# ===================
# Server Configuration
# ===================

# Server port (default: 8080)
PORT=8080

# Audio directory path(s)
# For multiple directories, separate with commas
# Use path:name format to give custom names to directories
# AUDIO_DIR=/path/to/audio1:Music Library,/path/to/audio2:Podcasts

# Content directory (for about.md, stats JSON files)
# CONTENT_DIR=./content

# Static files directory (for built frontend)
# STATIC_DIR=./static

# ===================
# Frontend Configuration (Runtime)
# ===================
# These are injected into the frontend at runtime by Go

# Site title and description
DEFAULT_TITLE=Audio Archive
DEFAULT_DESCRIPTION=Browse and listen to audio files

# Optional global info banner
# BANNER_MESSAGE=Requests are temporarily delayed this week.
# BANNER_VARIANT=info
# BANNER_LINK_TEXT=Learn more
# BANNER_LINK_URL=/requests

# Umami analytics (optional)
# UMAMI_URL=https://your-umami-instance.com/script.js
# UMAMI_WEBSITE_ID=your-website-id

# ===================
# Rate Limiting
# ===================

RATE_LIMIT_WINDOW=60000
MAX_REQUESTS_PER_WINDOW=100
STREAM_KEY_LIMITS=10/1m
DOWNLOAD_KEY_LIMITS=10/1m
STREAM_KEY_TTL=30m
DOWNLOAD_KEY_TTL=10m
# Optional delay before a newly created anonymous session may download.
DOWNLOAD_SESSION_MIN_AGE=0s
STREAM_BYTES_PER_SECOND=0
DOWNLOAD_BYTES_PER_SECOND=0
STREAM_IP_BYTES_PER_SECOND=0
DOWNLOAD_IP_BYTES_PER_SECOND=0
STREAM_IP_BURST_BYTES=0
DOWNLOAD_IP_BURST_BYTES=0
SHARE_REQUEST_LIMIT=3
SHARE_LIMIT_WINDOW=86400000
CONTACT_REQUEST_LIMIT=5
CONTACT_LIMIT_WINDOW=86400000

# Required for signing anonymous sessions and media access keys.
# Generate a long random value and keep it stable across restarts.
SESSION_SECRET=

# ===================
# Notifications (ntfy)
# ===================

NTFY_URL=https://ntfy.sh
NTFY_TOPIC=your-private-topic
NTFY_TOKEN=your-private-token
NTFY_PRIORITY=1
