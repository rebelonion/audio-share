# ===================
# Server Configuration
# ===================

# Server port (default: 8080)
PORT=8080

# Audio directory path(s)
# For multiple directories, separate with commas
# Use path:name format to give custom names to directories
# AUDIO_DIR=/path/to/audio1:Music Library,/path/to/audio2:Podcasts

# Content directory (for about.md, stats JSON files)
# CONTENT_DIR=./content

# Static files directory (for built frontend)
# STATIC_DIR=./static

# ===================
# Frontend Configuration (Runtime)
# ===================
# These are injected into the frontend at runtime by Go

# Site title and description
DEFAULT_TITLE=Audio Archive
DEFAULT_DESCRIPTION=Browse and listen to audio files

# Optional global info banner
# BANNER_MESSAGE=Requests are temporarily delayed this week.
# BANNER_VARIANT=info
# BANNER_LINK_TEXT=Learn more
# BANNER_LINK_URL=/requests

# Umami analytics (optional)
# UMAMI_URL=https://your-umami-instance.com/script.js
# UMAMI_WEBSITE_ID=your-website-id

# ===================
# Rate Limiting
# ===================

RATE_LIMIT_WINDOW=60000
MAX_REQUESTS_PER_WINDOW=100
IMAGE_RATE_LIMIT_WINDOW=60000
MAX_IMAGES_PER_WINDOW=300
STREAM_KEY_LIMITS=10/1m
DOWNLOAD_KEY_LIMITS=10/1m
STREAM_KEY_TTL=30m
DOWNLOAD_KEY_TTL=10m
# Optional delay before a newly created anonymous session may download.
DOWNLOAD_SESSION_MIN_AGE=0s
STREAM_BYTES_PER_SECOND=0
STREAM_BURST_BYTES=0
DOWNLOAD_BYTES_PER_SECOND=0
DOWNLOAD_BURST_BYTES=0
STREAM_IP_BYTES_PER_SECOND=0
DOWNLOAD_IP_BYTES_PER_SECOND=0
SHARE_REQUEST_LIMIT=3
SHARE_LIMIT_WINDOW=86400000
CONTACT_REQUEST_LIMIT=5
CONTACT_LIMIT_WINDOW=86400000

# Required for signing anonymous sessions and media access keys.
# Generate a long random value and keep it stable across restarts.
SESSION_SECRET=

# Protects write operations under /api/admin, including targeted messages.
REQUESTS_API_KEY=

# ===================
# CAPTCHA (Cap Standalone)
# ===================

# Start the optional local Cap stack with:
# docker compose --profile cap up -d cap
# ADMIN_KEY is only used by the Cap dashboard. Use at least 32 random characters.
ADMIN_KEY=

# Roll out with "observe" first, then switch to "enforce".
CAP_ENFORCEMENT=off
# Public widget endpoint: https://<cap-host>/<site-key>/
CAP_PUBLIC_ENDPOINT=
# Vite dev uses this browser-facing endpoint from the repository-root .env.local.
VITE_CAP_PUBLIC_ENDPOINT=
# Server-side verification endpoint: https://<cap-host>/<site-key>/siteverify
# In Docker Compose this may use http://cap:3000/<site-key>/siteverify.
CAP_VERIFY_ENDPOINT=
# Secret for the site key, not the Cap dashboard ADMIN_KEY.
CAP_SECRET_KEY=
CAP_VERIFY_TIMEOUT=3s

# Challenge streaming once either the session or IP reaches any rolling limit.
# Leave empty to disable stream challenges. Keep STREAM_KEY_LIMITS higher.
STREAM_CAPTCHA_LIMITS=
STREAM_CAPTCHA_CLEARANCE_TTL=15m

# "always" challenges every download key request; "off" disables it.
DOWNLOAD_CAPTCHA_MODE=always

# ===================
# Notifications (ntfy)
# ===================

NTFY_URL=https://ntfy.sh
NTFY_TOPIC=your-private-topic
NTFY_TOKEN=your-private-token
NTFY_PRIORITY=1

# Host path mounted read-only into the app container.
SOURCE_NORMALIZER_PATH=/scripts/source_normalizer.py
SOURCE_NORMALIZER_TIMEOUT=15s
